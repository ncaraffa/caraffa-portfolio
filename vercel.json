{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "caraffa-portfolio.vercel.app" }],
      "destination": "https://nicolascaraffa.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nicolascaraffa.dev" }],
      "destination": "https://nicolascaraffa.dev/:path*",
      "permanent": true
    }
  ]
}
